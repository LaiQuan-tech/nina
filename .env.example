# Supabase（work_orders 資料表 + print-files 私有 Storage bucket）
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service_role key>   # 僅 server 端使用，切勿加 NEXT_PUBLIC_ 前綴

# Gemini（選配：只用來把檔名錯誤潤飾成親切的中文引導；未設定則用內建純文字訊息）
GEMINI_API_KEY=<gemini api key>

# 管理後台：HMAC 簽 cookie 的密鑰（openssl rand -hex 32）。多帳號在 admin_users 表，用 scripts/createAdmin.mjs 建。
ADMIN_SESSION_SECRET=<random 32-byte hex>

# 前台會員 session 簽章密鑰（與後台的 ADMIN_SESSION_SECRET 必須不同）
MEMBER_SESSION_SECRET=<random 32 bytes base64url>

# 收檔後自動推上美強光 Synology NAS 的 FTP（見 lib/ftp/push.ts）。缺任一項時
# pushWorkOrderToFtp 會明確 throw「FTP 未設定」，工單維持 ftp_status='pending' 等重試。
FTP_HOST=<NAS 的網域或 IP>
FTP_PORT=21
FTP_USER=<FTP 帳號>
FTP_PASS=<FTP 密碼>
FTP_BASE_DIR=網站收稿
FTP_SECURE=false   # 'true' 時走 FTPS explicit；一般 FTP 留 false 或不設

# app/api/cron/ftp-push 的授權密鑰：Vercel 專案設定裡把這個 cron job 的 Authorization
# 設成 Bearer <CRON_SECRET>，平台觸發時會自動帶上（openssl rand -hex 32）。
CRON_SECRET=<random 32-byte hex>
